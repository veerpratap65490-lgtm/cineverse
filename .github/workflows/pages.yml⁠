        </div>
    </section>

    <main id="movieSection" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 w-full flex-1">
        
        <!-- Navigation Tabs & Genre Filter Container -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-8">
            
            <!-- Section Title / Tab Switcher -->
            <div class="flex items-center gap-2 p-1 bg-white/5 rounded-xl border border-white/10">
                <button id="tab-btn-featured" onclick="switchTab('featured')" class="px-4 py-2 rounded-lg text-sm font-bold transition-all bg-brand-red text-white shadow-md">
                    Featured Movies
                </button>
                <button id="tab-btn-upcoming" onclick="switchTab('upcoming')" class="px-4 py-2 rounded-lg text-sm font-bold text-gray-400 hover:text-white transition-all">
                    Upcoming Releases
                </button>
            </div>

            <!-- Genre Filter Pills -->
            <div class="w-full md:w-auto overflow-x-auto hide-scrollbar pb-2 md:pb-0">
                <div class="flex items-center gap-2 text-xs font-semibold" id="genreContainer">
                    <!-- Dynamic Pills inserted via JS -->
                </div>
            </div>
        </div>

        <!-- Movie Cards Grid -->
        <div id="movieGrid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
            <!-- Dynamic Movie Cards Render Here -->
        </div>

        <!-- Empty Results State -->
        <div id="emptyState" class="hidden text-center py-20">
            <div class="w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-4 border border-white/10 text-gray-400 text-2xl">
                <i class="fa-solid fa-film"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-1">No movies found</h3>
            <p class="text-sm text-gray-400">Try searching for a different title or clearing your genre filters.</p>
            <button onclick="resetFilters()" class="mt-4 px-4 py-2 bg-brand-red text-white text-xs font-bold rounded-lg hover:bg-brand-redDark transition-all">
                Reset Filters
            </button>
        </div>
    </main>

    <div id="movieModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden">
        <div class="relative w-full max-w-2xl bg-brand-card border border-white/10 rounded-2xl overflow-hidden shadow-2xl modal-enter max-h-[90vh] flex flex-col">
            
            <!-- Modal Close Button -->
            <button onclick="closeModal()" class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-black/60 hover:bg-black text-white flex items-center justify-center border border-white/20 transition-all">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>

            <!-- Banner / Image Area -->
            <div class="relative h-56 sm:h-72 overflow-hidden flex items-end p-6">
                <img id="modalPoster" src="" alt="Movie Poster" class="absolute inset-0 w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-brand-card via-brand-card/60 to-transparent"></div>
                <div class="relative z-10 flex items-center gap-3">
                    <span id="modalGenreBadge" class="px-3 py-1 rounded-full text-xs font-extrabold bg-brand-red text-white shadow-lg"></span>
                    <span id="modalYearBadge" class="px-3 py-1 rounded-full text-xs font-semibold bg-black/60 text-white border border-white/20 backdrop-blur-sm"></span>
                </div>
            </div>

            <!-- Modal Content Body -->
            <div class="p-6 overflow-y-auto space-y-4 flex-1">
                <div class="flex items-start justify-between gap-4">
                    <h2 id="modalTitle" class="text-2xl sm:text-3xl font-extrabold text-white leading-tight"></h2>
                    <div id="modalRatingContainer" class="flex items-center gap-1.5 bg-yellow-500/10 border border-yellow-500/30 px-3 py-1 rounded-lg shrink-0">
                        <i class="fa-solid fa-star text-yellow-400 text-sm"></i>
                        <span id="modalRating" class="text-yellow-400 font-bold text-sm"></span>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-4 text-xs text-gray-400 border-y border-white/10 py-3">
                    <div><span class="text-gray-500">Director:</span> <span id="modalDirector" class="text-gray-200 font-medium"></span></div>
                    <div><span class="text-gray-500">Runtime:</span> <span id="modalRuntime" class="text-gray-200 font-medium"></span></div>
                </div>

                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">Synopsis</h4>
                    <p id="modalSynopsis" class="text-sm text-gray-300 leading-relaxed"></p>
                </div>

                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">Starring</h4>
                    <p id="modalCast" class="text-sm text-gray-300"></p>
                </div>

                <!-- Call to Action - Legal Watch Button -->
                <div class="pt-4 border-t border-white/10 flex flex-col sm:flex-row gap-3">
                    <a id="modalWatchBtn" href="#" target="_blank" rel="noopener noreferrer" 
                       class="flex-1 py-3.5 px-4 bg-brand-red hover:bg-brand-redDark text-white font-bold rounded-xl text-center text-sm shadow-lg shadow-brand-red/30 transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Find Where To Watch (JustWatch)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <footer id="about" class="mt-16 border-t border-white/10 bg-black/60 pt-12 pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-white/10">
                
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-8 h-8 rounded-lg bg-brand-red flex items-center justify-center text-white font-bold text-sm">
                            <i class="fa-solid fa-play"></i>
                        </div>
                        <span class="text-xl font-extrabold text-white">CINE<span class="text-brand-red">VERSE</span></span>
                    </div>
                    <p class="text-xs text-gray-400 leading-relaxed">
                        Your ultimate gateway for official movie discovery, release schedules, and verified legal streaming links across major global platforms.
                    </p>
                </div>

                <div>
                    <h4 class="text-white text-sm font-bold mb-3">Quick Navigation</h4>
                    <ul class="space-y-2 text-xs text-gray-400">
                        <li><button onclick="switchTab('featured')" class="hover:text-white transition-colors">Featured Movies</button></li>
                        <li><button onclick="switchTab('upcoming')" class="hover:text-white transition-colors">Upcoming Releases</button></li>
                        <li><a href="https://www.justwatch.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Powered by JustWatch Data Search</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="text-white text-sm font-bold mb-3">Legal & Safety Statement</h4>
                    <p class="text-xs text-gray-400 leading-relaxed">
                        CineVerse does not host or distribute copyrighted movie files. All movie info and poster art is provided for legal discovery purposes.
                    </p>
                </div>
            </div>

            <div class="pt-6 text-center text-xs text-gray-500">
                <p>&copy; 2026 CineVerse. All rights reserved. Compliant with legal movie discovery standards.</p>
            </div>
        </div>
    </footer>

    <script>
        /* Movie Dataset with high quality cinematic visual poster thumbnails */
        const movieData = {
            featured: [
                {
                    id: 'f1',
                    title: 'Neon City',
                    year: 2026,
                    genre: 'Sci-Fi',
                    rating: 8.5,
                    runtime: '2h 14m',
                    director: 'Elena Vance',
                    cast: 'Markus Chen, Sarah Jenkins, Kaelen Vos',
                    synopsis: 'In a rain-slicked metropolis powered by synthetic consciousness, a rogue detective investigates a cybernetic threat that threatens the fabric of human memory.',
                    posterImage: 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=600&q=80'
                },
                {
                    id: 'f2',
                    title: 'The Grand Adventure',
                    year: 2026,
                    genre: 'Adventure',
                    rating: 8.2,
                    runtime: '1h 58m',
                    director: 'Arthur Pendelton',
                    cast: 'David Ross, Maya Lin, Leo Sterling',
                    synopsis: 'An intrepid team of cartographers uncovers an uncharted archipelago holding ancient technological relics capable of controlling global weather patterns.',
                    posterImage: 'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=600&q=80'
                },
                {
                    id: 'f3',
                    title: 'Beyond The Horizon',
                    year: 2026,
                    genre: 'Drama',
                    rating: 7.9,
                    runtime: '2h 05m',
                    director: 'Sophia Lorenzi',
                    cast: 'Claire Redfield, Julian Thorne',
                    synopsis: 'An emotionally charged tale of two astronomers stationed in remote Patagonia who discover a strange signal that changes their perspective on life.',
                    posterImage: 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=600&q=80'
                },
                {
                    id: 'f4',
                    title: 'Midnight Chase',
                    year: 2026,
                    genre: 'Thriller',
                    rating: 8.0,
                    runtime: '1h 45m',
                    director: 'Marcus Thorne',
                    cast: 'Jaxxon Briggs, Nora Allen',
                    synopsis: 'A high-octane cat-and-mouse game through night-bound Berlin as an undercover agent races against time to stop an international syndicate.',
                    posterImage: 'https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=600&q=80'
                },
                {
                    id: 'f5',
                    title: 'Laughing Matters',
                    year: 2026,
                    genre: 'Comedy',
                    rating: 7.6,
                    runtime: '1h 32m',
                    director: 'Chloe Bennett',
                    cast: 'Sammy Cruz, Tina Fey, Rob Riggle',
                    synopsis: 'A struggling stand-up comedian accidentally becomes the campaign manager for an eccentric mayoral candidate with hilarious consequences.',
                    posterImage: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=600&q=80'
                },
                {
                    id: 'f6',
                    title: 'Ocean Blue',
                    year: 2025,
                    genre: 'Drama',
                    rating: 8.1,
                    runtime: '2h 20m',
                    director: 'Lucas Silva',
                    cast: 'Marina Del Rey, Oceanus Wade',
                    synopsis: 'A poignant marine biologist dedicates her life to protecting a newly discovered deep-sea organism while fighting offshore commercial development.',
                    posterImage: 'https://images.unsplash.com/photo-1682687220063-4742bd7fd538?auto=format&fit=crop&w=600&q=80'
                }
            ],
            upcoming: [
                {
                    id: 'u1',
                    title: 'Starlight',
                    year: 2027,
                    genre: 'Sci-Fi',
                    rating: 'TBA',
                    runtime: 'In Production',
                    director: 'Amara Vance',
                    cast: 'Jonah Hill, Zoe Saldana',
                    synopsis: 'The journey of the first manned interstellar vessel bound for Proxima Centauri as crew members face uncharted cosmic phenomena.',
                    posterImage: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=600&q=80'
                },
                {
                    id: 'u2',
                    title: 'The Last Summer',
                    year: 2027,
                    genre: 'Drama',
                    rating: 'TBA',
                    runtime: 'In Production',
                    director: 'Oliver Stone Jr.',
                    cast: 'Timothee Vance, Elle Fanning',
                    synopsis: 'A nostalgic coming-of-age story set along the sun-drenched coastline of Southern Italy during the summer of 1999.',
                    posterImage: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80'
                }
            ]
        };

        /* Application State */
        let currentTab = 'featured';
        let selectedGenre = 'All';
        let searchQuery = '';

        /* Genre Categories */
        const genres = ['All', 'Sci-Fi', 'Adventure', 'Drama', 'Thriller', 'Comedy'];

        document.addEventListener('DOMContentLoaded', () => {
            renderGenrePills();
            renderMovies();

            // Search input bindings
            document.getElementById('searchInput').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase();
                renderMovies();
            });

            document.getElementById('mobileSearchInput').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase();
                renderMovies();
            });

            // Mobile search bar toggle
            document.getElementById('mobileSearchBtn').addEventListener('click', () => {
                const container = document.getElementById('mobileSearchContainer');
                container.classList.toggle('hidden');
            });
        });

        function switchTab(tab) {
            currentTab = tab;
            
            const featBtn = document.getElementById('tab-btn-featured');
            const upBtn = document.getElementById('tab-btn-upcoming');
            const navFeat = document.getElementById('nav-featured');
            const navUp = document.getElementById('nav-upcoming');

            if (tab === 'featured') {
                featBtn.className = "px-4 py-2 rounded-lg text-sm font-bold transition-all bg-brand-red text-white shadow-md";
                upBtn.className = "px-4 py-2 rounded-lg text-sm font-bold text-gray-400 hover:text-white transition-all";
                navFeat.classList.add('text-brand-red');
                navUp.classList.remove('text-brand-red');
            } else {
                upBtn.className = "px-4 py-2 rounded-lg text-sm font-bold transition-all bg-brand-red text-white shadow-md";
                featBtn.className = "px-4 py-2 rounded-lg text-sm font-bold text-gray-400 hover:text-white transition-all";
                navUp.classList.add('text-brand-red');
                navFeat.classList.remove('text-brand-red');
            }

            renderMovies();
        }

        function renderGenrePills() {
            const container = document.getElementById('genreContainer');
            container.innerHTML = genres.map(genre => {
                const isActive = genre === selectedGenre;
                const activeClasses = isActive 
                    ? 'bg-brand-red text-white shadow-md border-brand-red' 
                    : 'bg-white/5 text-gray-300 hover:bg-white/10 border-white/10';

                return `
                    <button onclick="filterGenre('${genre}')" 
                        class="px-3.5 py-1.5 rounded-full border transition-all shrink-0 ${activeClasses}">
                        ${genre}
                    </button>
                `;
            }).join('');
        }

        function filterGenre(genre) {
            selectedGenre = genre;
            renderGenrePills();
            renderMovies();
        }

        function resetFilters() {
            selectedGenre = 'All';
            searchQuery = '';
            document.getElementById('searchInput').value = '';
            document.getElementById('mobileSearchInput').value = '';
            renderGenrePills();
            renderMovies();
        }

        function renderMovies() {
            const grid = document.getElementById('movieGrid');
            const emptyState = document.getElementById('emptyState');
            
            const activeList = movieData[currentTab];

            const filteredMovies = activeList.filter(movie => {
                const matchesGenre = selectedGenre === 'All' || movie.genre.includes(selectedGenre);
                const matchesSearch = movie.title.toLowerCase().includes(searchQuery) || 
                                      movie.genre.toLowerCase().includes(searchQuery) ||
                                      movie.year.toString().includes(searchQuery);
                return matchesGenre && matchesSearch;
            });

            if (filteredMovies.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            grid.innerHTML = filteredMovies.map(movie => `
                <div onclick="openModal('${movie.id}')" class="movie-card glass-card rounded-2xl overflow-hidden cursor-pointer flex flex-col group border border-white/10">
                    <!-- Poster Container -->
                    <div class="relative aspect-[2/3] overflow-hidden bg-gray-900">
                        <img src="${movie.posterImage}" alt="${movie.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/30 opacity-80"></div>
                        
                        <div class="absolute top-3 left-3 right-3 flex items-center justify-between z-10">
                            <span class="px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-md text-[10px] font-extrabold text-white border border-white/10">
                                ${movie.genre}
                            </span>
                            ${movie.rating !== 'TBA' ? `
                                <span class="px-2 py-0.5 rounded-md bg-yellow-500/20 backdrop-blur-md text-[10px] font-bold text-yellow-400 border border-yellow-500/30 flex items-center gap-1">
                                    <i class="fa-solid fa-star text-[9px]"></i> ${movie.rating}
                                </span>
                            ` : `
                                <span class="px-2 py-0.5 rounded-md bg-blue-500/20 backdrop-blur-md text-[10px] font-bold text-blue-400 border border-blue-500/30">
                                    Upcoming
                                </span>
                            `}
                        </div>

                        <div class="absolute bottom-3 left-3 right-3 z-10">
                            <span class="text-[11px] font-semibold text-gray-300">${movie.year}</span>
                            <h3 class="text-base font-extrabold text-white line-clamp-1 leading-snug group-hover:text-brand-red transition-colors">${movie.title}</h3>
                        </div>
                    </div>

                    <!-- Footer Info -->
                    <div class="p-3 bg-brand-card flex items-center justify-between text-xs font-semibold text-gray-300 border-t border-white/5">
                        <span class="text-[11px] text-gray-400"><i class="fa-regular fa-clock mr-1"></i>${movie.runtime}</span>
                        <span class="text-brand-red group-hover:translate-x-1 transition-transform flex items-center gap-1 text-[11px]">
                            Details <i class="fa-solid fa-chevron-right text-[9px]"></i>
                        </span>
                    </div>
                </div>
            `).join('');
        }

        function openModal(id) {
            const allMovies = [...movieData.featured, ...movieData.upcoming];
            const movie = allMovies.find(m => m.id === id);

            if (!movie) return;

            document.getElementById('modalTitle').innerText = movie.title;
            document.getElementById('modalGenreBadge').innerText = movie.genre;
            document.getElementById('modalYearBadge').innerText = movie.year;
            document.getElementById('modalSynopsis').innerText = movie.synopsis;
            document.getElementById('modalDirector').innerText = movie.director;
            document.getElementById('modalCast').innerText = movie.cast;
            document.getElementById('modalRuntime').innerText = movie.runtime;
            document.getElementById('modalPoster').src = movie.posterImage;

            const ratingContainer = document.getElementById('modalRatingContainer');
            if (movie.rating !== 'TBA') {
                ratingContainer.classList.remove('hidden');
                document.getElementById('modalRating').innerText = movie.rating;
            } else {
                ratingContainer.classList.add('hidden');
            }

            // JustWatch URL generator for official streaming options
            const justWatchUrl = `https://www.justwatch.com/us/search?q=${encodeURIComponent(movie.title)}`;
            document.getElementById('modalWatchBtn').href = justWatchUrl;

            const modal = document.getElementById('movieModal');
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            const modal = document.getElementById('movieModal');
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }

        document.getElementById('movieModal').addEventListener('click', (e) => {
            if (e.target.id === 'movieModal') closeModal();
        });

        function scrollToMovies() {
            document.getElementById('movieSection').scrollIntoView({ behavior: 'smooth' });
        }
    </script>
</body>
</html>