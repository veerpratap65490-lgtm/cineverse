                    class="w-full bg-black/80 border border-white/10 rounded-full py-2.5 pl-11 pr-4 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-brand-red">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-gray-400 text-sm"></i>
            </div>
        </div>
    </header>

    <section class="relative py-8 md:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
        <div class="absolute inset-0 -z-10 overflow-hidden rounded-3xl">
            <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-red/20 rounded-full blur-3xl"></div>
            <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-brand-cyan/15 rounded-full blur-3xl"></div>
        </div>

        <div class="glass-card rounded-3xl p-6 sm:p-10 md:p-12 relative overflow-hidden border border-white/10">
            <div class="max-w-2xl">
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-brand-red/10 text-brand-red border border-brand-red/20 mb-4">
                    <i class="fa-solid fa-shield-halved"></i> 100% Legal & Official Streaming Guide
                </span>
                <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-4">
                    Discover Movies & Find Where To Stream Them
                </h1>
                <p class="text-gray-300 text-sm sm:text-base mb-6 leading-relaxed">
                    Explore trending releases and upcoming blockbusters. We locate official streaming platforms, rental options, and legal theater showtimes worldwide.
                </p>
                <div class="flex flex-wrap gap-3">
                    <button onclick="scrollToMovies()" class="px-6 py-3 rounded-xl bg-brand-red hover:bg-brand-redDark text-white font-bold text-sm shadow-lg shadow-brand-red/30 active:scale-95 transition-all flex items-center gap-2">
                        <i class="fa-solid fa-compass"></i> Explore Movies
                    </button>
                    <a href="#about" class="px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-white font-bold text-sm border border-white/10 active:scale-95 transition-all flex items-center gap-2">
                        <i class="fa-solid fa-circle-info"></i> How It Works
                    </a>
                </div>
