            </a>

            <!-- Search Bar Desktop -->
            <div class="hidden md:flex flex-1 max-w-md mx-4 relative">
                <input type="text" id="searchInput" placeholder="Search movies, genres, release years..." 
                    class="w-full bg-black/60 border border-white/10 rounded-full py-2.5 pl-11 pr-4 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-brand-red focus:ring-1 focus:ring-brand-red transition-all">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-gray-400 text-sm"></i>
            </div>

            <!-- Desktop Nav Links -->
            <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold text-gray-300">
                <button onclick="switchTab('featured')" id="nav-featured" class="hover:text-brand-red transition-colors text-brand-red">Featured</button>
                <button onclick="switchTab('upcoming')" id="nav-upcoming" class="hover:text-brand-red transition-colors">Upcoming</button>
                <a href="#about" class="hover:text-brand-red transition-colors">Watch Guide</a>
            </nav>

            <!-- Mobile Search Icon Trigger -->
            <div class="flex items-center gap-2 md:hidden">
                <button id="mobileSearchBtn" class="p-2.5 text-gray-300 hover:text-white rounded-xl bg-white/5 border border-white/10 active:scale-95 transition-transform">
                    <i class="fa-solid fa-magnifying-glass text-lg"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Search Dropdown Bar -->
        <div id="mobileSearchContainer" class="hidden md:hidden px-4 pb-4 pt-1 border-t border-white/5 bg-brand-dark">
            <div class="relative">
